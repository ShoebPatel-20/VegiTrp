<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.VegiTrp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/nature_green</item>
        <item name="colorPrimaryVariant">@color/nature_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>

    <style name="Theme.VegiTrp.Farmer" parent="Theme.VegiTrp">
        <item name="colorPrimary">@color/nature_green</item>
        <item name="colorPrimaryVariant">@color/nature_green_dark</item>
    </style>

    <style name="Theme.VegiTrp.Buyer" parent="Theme.VegiTrp">
        <item name="colorPrimary">@color/buyer_green</item>
        <item name="colorPrimaryVariant">@color/buyer_green_dark</item>
    </style>

    <style name="Theme.VegiTrp.Driver" parent="Theme.VegiTrp">
        <item name="colorPrimary">@color/driver_blue</item>
        <item name="colorPrimaryVariant">@color/driver_blue_dark</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>

    <style name="CustomTabStyle" parent="TextAppearance.Design.Tab">
        <item name="android:singleLine">true</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
</resources>
