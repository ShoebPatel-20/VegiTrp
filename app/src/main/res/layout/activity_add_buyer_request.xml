<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/add_buyer_request_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_surface_light"
    tools:context=".activities.AddBuyerRequestActivity">

    <!-- Collapsible AppBar with Branded VegiTrp Buyer Header -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_buyer_header_gradient"
            app:contentScrim="@color/brand_green_primary"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="56dp"
                android:paddingEnd="20dp"
                android:paddingBottom="44dp"
                app:layout_collapseMode="parallax">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_circle_white"
                    android:backgroundTint="#26FFFFFF">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_market_cart"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.01"
                    android:text="@string/add_buyer_request_header_title"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/add_buyer_request_header_subtitle"
                    android:textColor="#E0FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationIcon="?attr/homeAsUpIndicator"
                app:navigationIconTint="@color/white" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Form Body -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- 3D Elevated Form Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-24dp"
                app:cardBackgroundColor="@color/brand_surface_card"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:cardMaxElevation="8dp"
                app:cardPreventCornerOverlap="true"
                app:strokeColor="@color/brand_card_stroke"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Order Requirements"
                        android:textColor="@color/brand_text_title"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Product / Vegetable Selection -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/add_buyer_request_produce_label"
                        android:textColor="@color/brand_text_muted"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spinner_vegetable_name"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_spinner_role"
                        android:paddingStart="14dp"
                        android:paddingEnd="40dp" />

                    <!-- Quantity & Unit Row -->
                    <LinearLayout
                        android:id="@+id/quantity_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="6"
                            android:hint="@string/add_buyer_request_quantity_hint"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxStrokeColor="@color/brand_green_primary"
                            app:boxStrokeWidth="1.2dp"
                            app:boxStrokeWidthFocused="2dp"
                            app:hintTextColor="@color/brand_green_primary"
                            app:startIconDrawable="@drawable/ic_box_package"
                            app:startIconTint="@color/brand_green_primary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_quantity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:inputType="numberDecimal"
                                android:textColor="@color/brand_text_title"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="4"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/add_buyer_request_unit_label"
                                android:textColor="@color/brand_text_muted"
                                android:textSize="12sp" />

                            <Spinner
                                android:id="@+id/spinner_unit"
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_spinner_role"
                                android:paddingStart="12dp"
                                android:paddingEnd="36dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Price Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="@string/add_buyer_request_price_hint"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/brand_green_primary"
                        app:boxStrokeWidth="1.2dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/brand_green_primary"
                        app:prefixText="₹ "
                        app:prefixTextColor="@color/brand_green_primary"
                        app:startIconDrawable="@drawable/ic_wallet"
                        app:startIconTint="@color/brand_green_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_price"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:inputType="numberDecimal"
                            android:textColor="@color/brand_text_title"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Pickup Address Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="@string/add_buyer_request_pickup_hint"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/brand_green_primary"
                        app:boxStrokeWidth="1.2dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:helperText="@string/add_buyer_request_pickup_helper"
                        app:helperTextTextColor="@color/brand_text_muted"
                        app:hintTextColor="@color/brand_green_primary"
                        app:startIconDrawable="@drawable/green_dot"
                        app:startIconTint="@color/brand_green_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_pickup_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:inputType="textPostalAddress|textCapWords"
                            android:textColor="@color/brand_text_title"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Delivery Address Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="@string/add_buyer_request_delivery_hint"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/brand_green_primary"
                        app:boxStrokeWidth="1.2dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:helperText="@string/add_buyer_request_delivery_helper"
                        app:helperTextTextColor="@color/brand_text_muted"
                        app:hintTextColor="@color/brand_green_primary"
                        app:startIconDrawable="@drawable/red_dot"
                        app:startIconTint="@color/brand_green_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_delivery_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:inputType="textPostalAddress|textCapWords"
                            android:textColor="@color/brand_text_title"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Destination Pin Code Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="28dp"
                        android:hint="@string/add_buyer_request_pincode_hint"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/brand_green_primary"
                        app:boxStrokeWidth="1.2dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:helperText="@string/add_buyer_request_pincode_helper"
                        app:helperTextTextColor="@color/brand_text_muted"
                        app:hintTextColor="@color/brand_green_primary"
                        app:startIconDrawable="@drawable/ic_location_pin"
                        app:startIconTint="@color/brand_green_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_pin_code"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:inputType="number"
                            android:maxLength="6"
                            android:textColor="@color/brand_text_title"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Submit Request Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_submit_request"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_login_button"
                        android:elevation="4dp"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.02"
                        android:text="@string/add_buyer_request_submit_button"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        app:cornerRadius="27dp"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconGravity="textEnd"
                        app:iconPadding="8dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/white" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
