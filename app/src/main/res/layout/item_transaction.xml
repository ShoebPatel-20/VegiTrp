<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/brand_card_stroke"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/brand_surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/rounded_background"
            android:backgroundTint="@color/brand_green_soft">

            <ImageView
                android:id="@+id/iv_transaction_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_trans_credit"
                android:contentDescription="Transaction Type" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_transaction_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Order Payment"
                android:text="Order Payment"
                android:textColor="@color/brand_text_title"
                android:textSize="15sp"
                android:fontFamily="sans-serif-bold"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_transaction_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="10 Oct 2026, 14:00"
                android:text="10 Oct 2026, 14:00"
                android:textColor="@color/brand_text_muted"
                android:fontFamily="sans-serif-medium"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_transaction_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="+₹50.00"
            android:text="+₹50.00"
            android:textColor="@color/brand_green_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-bold"
            android:textStyle="bold" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
