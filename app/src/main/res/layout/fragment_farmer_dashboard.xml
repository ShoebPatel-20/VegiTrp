<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/farmer_dashboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_surface_light"
    android:orientation="vertical"
    tools:context=".fragments.FarmerDashboardFragment">

    <!-- Top Tab Bar Header Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_tab_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/brand_surface_card"
        app:cardCornerRadius="0dp"
        app:cardElevation="3dp"
        app:cardMaxElevation="4dp"
        app:strokeColor="@color/brand_card_stroke"
        app:strokeWidth="1dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/brand_surface_card"
            app:tabGravity="fill"
            app:tabIndicator="@drawable/bg_tab_indicator_green"
            app:tabIndicatorAnimationMode="elastic"
            app:tabIndicatorColor="@color/brand_green_primary"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabRippleColor="@color/brand_green_tint"
            app:tabSelectedTextColor="@color/brand_green_primary"
            app:tabTextAppearance="@style/CustomTabStyle"
            app:tabTextColor="@color/brand_text_muted" />
    </com.google.android.material.card.MaterialCardView>

    <!-- ViewPager for Orders List Tabs -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
