<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/driver_dashboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_surface_light"
    android:orientation="vertical"
    tools:context=".fragments.DriverDashboardFragment">

    <!-- Top Tab Bar Header Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_tab_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/brand_surface_card"
        app:cardCornerRadius="0dp"
        app:cardElevation="3dp"
        app:cardMaxElevation="4dp"
        app:strokeColor="@color/brand_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Title & Role Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <!-- Transport Icon Badge -->
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_stat_icon_emerald">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_truck_fast"
                        app:tint="@color/brand_green_primary" />
                </FrameLayout>

                <!-- Title and Subtitle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.01"
                        android:text="@string/driver_dashboard_title"
                        android:textColor="@color/brand_text_title"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/driver_dashboard_subtitle"
                        android:textColor="@color/brand_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Role Badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_background"
                    android:backgroundTint="@color/brand_green_soft"
                    android:letterSpacing="0.05"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/driver_dashboard_role_badge"
                    android:textColor="@color/brand_green_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Subtle Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/brand_card_stroke" />

            <!-- Tabs Container -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/brand_surface_card"
                app:tabGravity="fill"
                app:tabIndicator="@drawable/bg_tab_indicator_green"
                app:tabIndicatorAnimationMode="elastic"
                app:tabIndicatorColor="@color/brand_green_primary"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="3dp"
                app:tabMaxWidth="0dp"
                app:tabMinWidth="0dp"
                app:tabMode="fixed"
                app:tabPaddingEnd="4dp"
                app:tabPaddingStart="4dp"
                app:tabRippleColor="@color/brand_green_tint"
                app:tabSelectedTextColor="@color/brand_green_primary"
                app:tabTextAppearance="@style/CustomTabStyle"
                app:tabTextColor="@color/brand_text_muted" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ViewPager for Rides List Tabs -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
