<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/brand_surface_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardMaxElevation="4dp"
    app:cardPreventCornerOverlap="true"
    app:strokeColor="@color/brand_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">

        <!-- Vehicle Transport Icon Container -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_stat_icon_emerald">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_truck_fast"
                app:tint="@color/brand_green_primary" />
        </FrameLayout>

        <!-- Vehicle Details (Name and Registration Number) -->
        <LinearLayout
            android:id="@+id/vehicle_info_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_vehicle_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:textColor="@color/brand_text_title"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Tata Ace Gold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_license_plate"
                    app:tint="@color/brand_text_muted" />

                <TextView
                    android:id="@+id/tv_vehicle_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:textColor="@color/brand_text_muted"
                    android:textSize="13sp"
                    tools:text="MH 12 AB 1234" />
            </LinearLayout>
        </LinearLayout>

        <!-- Edit & Delete Action Buttons -->
        <LinearLayout
            android:id="@+id/buttons_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Edit Button -->
            <ImageButton
                android:id="@+id/btn_edit_vehicle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_white"
                android:backgroundTint="@color/brand_green_light"
                android:contentDescription="@string/edit_vehicle_button_description"
                android:padding="9dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/brand_green_primary" />

            <!-- Delete Button -->
            <ImageButton
                android:id="@+id/btn_delete_vehicle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_white"
                android:backgroundTint="#FFEBEE"
                android:contentDescription="@string/delete_vehicle_button_description"
                android:padding="9dp"
                android:src="@drawable/ic_delete"
                app:tint="#D32F2F" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
