<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:contentScrim="#15803D"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:statusBarScrim="#15803D">

            <!-- Banner Image / Header Graphic -->
            <ImageView
                android:id="@+id/ivProfileBanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#15803D"
                android:src="@drawable/bg_vegetables"
                app:layout_collapseMode="parallax"
                android:contentDescription="Profile Banner" />

            <!-- Dark gradient overlay on banner for contrast -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#55000000"
                app:layout_collapseMode="parallax" />

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarProfile"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="?attr/homeAsUpIndicator"
                app:layout_collapseMode="pin">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/farmer_profile_header_title"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </androidx.appcompat.widget.Toolbar>

            <!-- Edit/Settings icon on Top Right -->
            <ImageView
                android:id="@+id/ivEditProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:padding="8dp"
                android:src="@drawable/ic_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#FFFFFF"
                android:elevation="4dp"
                android:contentDescription="@string/edit_profile_button_description"
                app:layout_collapseMode="pin" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Profile Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="56dp"
                    android:paddingBottom="20dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center_horizontal">

                    <!-- Farmer Name -->
                    <TextView
                        android:id="@+id/tvProfileFarmerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Kisan Verma"
                        android:text="@string/user_name_placeholder"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:gravity="center" />

                    <!-- Role Badge / Subtitle -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="#ECFDF5"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_leaf_logo"
                            app:tint="#16A34A"
                            android:contentDescription="Farmer Icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/farmer_profile_role_badge"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#16A34A" />
                    </LinearLayout>

                    <!-- Location Sub-Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_location_pin"
                            app:tint="#64748B"
                            android:contentDescription="Location Icon" />

                        <TextView
                            android:id="@+id/tvProfileFarmLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            tools:text="Rural Green Valley, Sector 4"
                            android:text="@string/location_hint"
                            android:textSize="13sp"
                            android:textColor="#64748B" />
                    </LinearLayout>

                    <!-- Email Sub-Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_email"
                            app:tint="#94A3B8"
                            android:contentDescription="Email Icon" />

                        <TextView
                            android:id="@+id/tvProfileFarmerEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            tools:text="farmer.kisan@example.com"
                            android:text="@string/user_email_placeholder"
                            android:textSize="12sp"
                            android:textColor="#94A3B8" />
                    </LinearLayout>

                    <!-- Stats Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="20dp"
                        android:weightSum="3"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="#F8FAFC"
                        android:padding="12dp">

                        <!-- Active Listed Stat -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvActiveListed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="15"
                                android:text="15"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#15803D" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/farmer_profile_active_crops_label"
                                android:textSize="12sp"
                                android:textColor="#64748B"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#E2E8F0" />

                        <!-- Rating Stat -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/tvAverageRating"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="4.9"
                                    android:text="4.9"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="#15803D" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" ★"
                                    android:textSize="14sp"
                                    android:textColor="#F59E0B" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/farmer_profile_rating_label"
                                android:textSize="12sp"
                                android:textColor="#64748B"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#E2E8F0" />

                        <!-- Items Sold Stat -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvItemsSold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="850+"
                                android:text="850+"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#15803D" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/farmer_profile_items_sold_label"
                                android:textSize="12sp"
                                android:textColor="#64748B"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Highlights / Information Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/farmer_profile_about_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <!-- Point 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_leaf_logo"
                            app:tint="#16A34A"
                            android:contentDescription="Produce Icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/farmer_profile_fresh_produce"
                            android:textSize="13sp"
                            android:textColor="#475569" />
                    </LinearLayout>

                    <!-- Point 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_home"
                            app:tint="#16A34A"
                            android:contentDescription="Market Icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/farmer_profile_direct_market"
                            android:textSize="13sp"
                            android:textColor="#475569" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- RecyclerView for listings if dynamically populated in future -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFarmerListings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                android:paddingBottom="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Avatar with anchor to AppBarLayout -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ivFarmerProfile"
        android:layout_width="96dp"
        android:layout_height="96dp"
        app:layout_anchor="@id/appbar"
        app:layout_anchorGravity="bottom|center"
        android:src="@drawable/ic_profile_placeholder"
        app:civ_border_width="3dp"
        app:civ_border_color="#FFFFFF"
        android:elevation="6dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
