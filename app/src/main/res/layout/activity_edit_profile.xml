<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_surface_light"
    android:orientation="vertical">

    <!-- App Bar & Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_surface_card"
        android:theme="@style/ThemeOverlay.AppCompat.Light"
        app:elevation="1dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/brand_surface_card"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:title="">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_profile_header_title"
                    android:textColor="@color/brand_text_title"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-bold"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_profile_header_subtitle"
                    android:textColor="@color/brand_text_muted"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="11sp" />
            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Avatar Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp">

                <RelativeLayout
                    android:id="@+id/rlAvatarSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp">

                    <!-- Profile Circle Avatar -->
                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivEditAvatar"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:src="@drawable/ic_profile_placeholder"
                        app:civ_border_color="@color/white"
                        app:civ_border_width="3dp"
                        android:elevation="4dp" />

                    <!-- Edit Camera Badge -->
                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_alignEnd="@id/ivEditAvatar"
                        android:layout_alignBottom="@id/ivEditAvatar"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="@color/brand_green_primary"
                        android:elevation="6dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/white"
                            android:contentDescription="@string/edit_profile_tap_photo_hint" />
                    </FrameLayout>

                    <!-- Upload ProgressBar -->
                    <ProgressBar
                        android:id="@+id/pbAvatarUpload"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_centerInParent="true"
                        android:indeterminateTint="@color/brand_green_primary"
                        android:elevation="8dp"
                        android:visibility="gone" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/edit_profile_tap_photo_hint"
                    android:textColor="@color/brand_text_muted"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Personal Information Section Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_profile_personal_details_title"
                android:textColor="@color/brand_text_title"
                android:textSize="14sp"
                android:fontFamily="sans-serif-bold"
                android:textStyle="bold"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp" />

            <!-- Personal Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/brand_card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/brand_surface_card"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Name Row -->
                    <LinearLayout
                        android:id="@+id/rowName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <!-- Icon Badge -->
                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/rounded_background"
                            android:backgroundTint="@color/brand_green_soft">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_person"
                                app:tint="@color/brand_green_primary"
                                android:contentDescription="@string/name_hint" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/name_hint"
                                android:textColor="@color/brand_text_muted"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvNameValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Ramesh Kumar"
                                android:text="Loading..."
                                android:textColor="@color/brand_text_title"
                                android:textSize="15sp"
                                android:fontFamily="sans-serif-bold"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/brand_text_muted"
                            android:contentDescription="Edit" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="68dp"
                        android:background="@color/brand_card_stroke" />

                    <!-- Mobile Row -->
                    <LinearLayout
                        android:id="@+id/rowMobile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <!-- Icon Badge -->
                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/rounded_background"
                            android:backgroundTint="@color/brand_green_soft">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_phone"
                                app:tint="@color/brand_green_primary"
                                android:contentDescription="@string/mobile_hint" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mobile_hint"
                                android:textColor="@color/brand_text_muted"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvMobileValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="+91 9876543210"
                                android:text="Loading..."
                                android:textColor="@color/brand_text_title"
                                android:textSize="15sp"
                                android:fontFamily="sans-serif-bold"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/brand_text_muted"
                            android:contentDescription="Edit" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Account & Contact Section Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_profile_account_details_title"
                android:textColor="@color/brand_text_title"
                android:textSize="14sp"
                android:fontFamily="sans-serif-bold"
                android:textStyle="bold"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp" />

            <!-- Account Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/brand_card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/brand_surface_card"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Email Row -->
                    <LinearLayout
                        android:id="@+id/rowEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <!-- Icon Badge -->
                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/rounded_background"
                            android:backgroundTint="@color/brand_green_soft">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_email"
                                app:tint="@color/brand_green_primary"
                                android:contentDescription="@string/email_hint" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/email_hint"
                                android:textColor="@color/brand_text_muted"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvEmailValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="ramesh.farmer@example.com"
                                android:text="Loading..."
                                android:textColor="@color/brand_text_title"
                                android:textSize="15sp"
                                android:fontFamily="sans-serif-bold"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/brand_text_muted"
                            android:contentDescription="Edit" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Security / Privacy Note -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/rounded_background"
                android:backgroundTint="@color/brand_surface_card"
                android:padding="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/brand_text_muted"
                    android:contentDescription="Security note" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/edit_profile_security_note"
                    android:textColor="@color/brand_text_muted"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
