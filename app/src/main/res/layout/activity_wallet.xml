<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/brand_surface_light">

    <!-- Top App Bar / Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_green_primary"
        app:titleTextColor="@color/white"
        app:navigationIconTint="@color/white"
        app:title="@string/wallet_toolbar_title"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6"
        android:elevation="4dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- 1. WALLET HERO BALANCE CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/brand_card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/brand_surface_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/wallet_balance_label"
                            android:textColor="@color/brand_green_primary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-bold"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/rounded_background"
                            android:backgroundTint="@color/brand_green_soft">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_wallet"
                                app:tint="@color/brand_green_primary"
                                android:contentDescription="@string/wallet_toolbar_title" />
                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_wallet_balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0.00"
                        tools:text="₹1,250.00"
                        android:textColor="@color/brand_text_title"
                        android:textSize="36sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wallet_balance_subtitle"
                        android:textColor="@color/brand_text_muted"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_withdraw"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/wallet_btn_withdraw"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-bold"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_wallet"
                        app:iconTint="@color/white"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        android:backgroundTint="@color/brand_green_primary"
                        app:cornerRadius="12dp"
                        android:elevation="1dp"
                        android:layout_marginTop="18dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. WEEKLY EARNINGS ANALYTICS CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/brand_card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/brand_surface_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wallet_chart_title"
                        android:textColor="@color/brand_text_title"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-bold"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wallet_chart_subtitle"
                        android:textColor="@color/brand_text_muted"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp" />

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/walletBarChart"
                        android:layout_width="match_parent"
                        android:layout_height="180dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. RECENT TRANSACTIONS SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wallet_recent_transactions_title"
                    android:textColor="@color/brand_text_title"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-bold"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Empty State View -->
            <LinearLayout
                android:id="@+id/layout_empty_transactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:paddingTop="32dp"
                android:paddingBottom="32dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_wallet"
                    app:tint="@color/brand_text_muted"
                    android:contentDescription="Empty Transactions" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/wallet_empty_transactions"
                    android:textColor="@color/brand_text_title"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/wallet_empty_transactions_sub"
                    android:textColor="@color/brand_text_muted"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="12sp"
                    android:gravity="center" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_transactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                tools:listitem="@layout/item_transaction" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
