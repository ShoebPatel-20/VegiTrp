<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_surface_light">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:contentScrim="@color/brand_green_primary"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:statusBarScrim="@color/brand_green_primary">

            <!-- Banner Image / Header Graphic -->
            <ImageView
                android:id="@+id/ivProfileBanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/brand_green_primary"
                android:src="@drawable/bg_vegetables"
                app:layout_collapseMode="parallax"
                android:contentDescription="Profile Banner" />

            <!-- Dark gradient overlay on banner for contrast -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#55000000"
                app:layout_collapseMode="parallax" />

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarProfile"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="?attr/homeAsUpIndicator"
                app:layout_collapseMode="pin">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/buyer_profile_header_title"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-bold"
                    android:textStyle="bold" />

            </androidx.appcompat.widget.Toolbar>

            <!-- Edit/Settings icon on Top Right -->
            <ImageView
                android:id="@+id/ivEditProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:padding="8dp"
                android:src="@drawable/ic_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"
                android:elevation="4dp"
                android:contentDescription="@string/edit_profile_button_description"
                app:layout_collapseMode="pin" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Profile Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/brand_card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/brand_surface_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="56dp"
                    android:paddingBottom="20dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center_horizontal">

                    <!-- Buyer Name -->
                    <TextView
                        android:id="@+id/tvProfileBuyerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Ananya Sharma"
                        android:text="@string/user_name_placeholder"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold"
                        android:textColor="@color/brand_text_title"
                        android:gravity="center" />

                    <!-- Role Badge / Subtitle -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="@color/brand_green_soft"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_market_cart"
                            app:tint="@color/brand_green_primary"
                            android:contentDescription="Cart Icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/buyer_profile_role_badge"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-bold"
                            android:textStyle="bold"
                            android:textColor="@color/brand_green_primary" />
                    </LinearLayout>

                    <!-- Location Sub-Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_location_pin"
                            app:tint="@color/brand_text_muted"
                            android:contentDescription="Location Icon" />

                        <TextView
                            android:id="@+id/tvProfileBuyerLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            tools:text="Region: Market Hub 1"
                            android:text="Region: Market Hub 1"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/brand_text_muted" />
                    </LinearLayout>

                    <!-- Stats Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="20dp"
                        android:weightSum="3"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="@color/brand_surface_light"
                        android:padding="12dp">

                        <!-- Orders Stat -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="23"
                                android:textSize="18sp"
                                android:fontFamily="sans-serif-black"
                                android:textStyle="bold"
                                android:textColor="@color/brand_green_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/buyer_profile_orders_label"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/brand_text_muted"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/brand_card_stroke" />

                        <!-- Rating Stat -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/tvAverageRating"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="5.0"
                                    android:text="5.0"
                                    android:textSize="18sp"
                                    android:fontFamily="sans-serif-black"
                                    android:textStyle="bold"
                                    android:textColor="@color/brand_green_primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" ★"
                                    android:textSize="14sp"
                                    android:textColor="@color/brand_accent_gold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/buyer_profile_trust_score_label"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/brand_text_muted"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/brand_card_stroke" />

                        <!-- Membership Stat -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1 Yr"
                                android:textSize="18sp"
                                android:fontFamily="sans-serif-black"
                                android:textStyle="bold"
                                android:textColor="@color/brand_green_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/buyer_profile_member_label"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/brand_text_muted"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Highlights / Information Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/brand_card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/brand_surface_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/buyer_profile_highlights_title"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-bold"
                        android:textStyle="bold"
                        android:textColor="@color/brand_text_title" />

                    <!-- Point 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_market_cart"
                            app:tint="@color/brand_green_primary"
                            android:contentDescription="Market Icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/buyer_profile_verified_procurement"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/brand_text_body" />
                    </LinearLayout>

                    <!-- Point 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_wallet"
                            app:tint="@color/brand_green_primary"
                            android:contentDescription="Wallet Icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/buyer_profile_secure_transactions"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/brand_text_body" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Purchases RecyclerView (optional / placeholder) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBuyerPurchases"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                android:paddingBottom="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Avatar with anchor to AppBarLayout -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ivBuyerProfile"
        android:layout_width="96dp"
        android:layout_height="96dp"
        app:layout_anchor="@id/appbar"
        app:layout_anchorGravity="bottom|center"
        android:src="@drawable/ic_profile_placeholder"
        app:civ_border_width="3dp"
        app:civ_border_color="@color/white"
        android:elevation="6dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
