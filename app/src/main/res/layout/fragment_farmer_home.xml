<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/farmer_home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_surface_light"
    tools:context=".fragments.FarmerHomeFragment">

    <!-- Top Custom Farmer Banner Header -->
    <LinearLayout
        android:id="@+id/header_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_farmer_header_gradient"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Farmer Avatar -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_header_avatar"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_profile_placeholder"
            app:civ_border_color="@android:color/white"
            app:civ_border_width="2.5dp" />

        <!-- Greeting & Role Badge -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_greeting_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.01"
                android:text="Hello, Farmer"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_farmer_role_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_circle_white"
                android:backgroundTint="#33FFFFFF"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp"
                android:text="@string/farmer_home_role_badge"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quick Wallet Action -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="#26FFFFFF"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#4DFFFFFF"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/iv_header_wallet"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/title_dashboard"
                android:focusable="true"
                android:src="@drawable/ic_wallet"
                app:tint="@color/white" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Scrollable Body Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_farmer_home"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_block">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Section Title -->
            <TextView
                android:id="@+id/tv_section_overview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                android:text="@string/farmer_home_overview_title"
                android:textColor="@color/brand_text_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 3D Elevated 2x2 Stats Grid -->
            <GridLayout
                android:id="@+id/grid_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="2"
                android:columnOrderPreserved="false"
                android:rowCount="2">

                <!-- Card 1: Total Orders -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_total_orders"
                    android:layout_width="0dp"
                    android:layout_height="124dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/brand_surface_card"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="5dp"
                    app:cardMaxElevation="8dp"
                    app:cardPreventCornerOverlap="true"
                    app:strokeColor="@color/brand_card_stroke"
                    app:strokeWidth="1.2dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp">

                        <FrameLayout
                            android:id="@+id/fl_icon_total"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:background="@drawable/bg_stat_icon_green">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sprout_leaf"
                                app:tint="@color/brand_green_primary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_label_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:text="@string/farmer_home_total_orders"
                            android:textColor="@color/brand_text_body"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_total_orders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentBottom="true"
                            android:fontFamily="sans-serif-black"
                            android:text="0"
                            android:textColor="@color/brand_text_title"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: Active Orders -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_active_orders"
                    android:layout_width="0dp"
                    android:layout_height="124dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/brand_surface_card"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="5dp"
                    app:cardMaxElevation="8dp"
                    app:cardPreventCornerOverlap="true"
                    app:strokeColor="@color/brand_card_stroke"
                    app:strokeWidth="1.2dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp">

                        <FrameLayout
                            android:id="@+id/fl_icon_active"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:background="@drawable/bg_stat_icon_amber">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_truck_fast"
                                app:tint="@color/brand_accent_orange" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_label_active"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:text="@string/farmer_home_active_orders"
                            android:textColor="@color/brand_text_body"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_active_orders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentBottom="true"
                            android:fontFamily="sans-serif-black"
                            android:text="0"
                            android:textColor="@color/brand_text_title"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 3: Completed Orders -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_completed_orders"
                    android:layout_width="0dp"
                    android:layout_height="124dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/brand_surface_card"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="5dp"
                    app:cardMaxElevation="8dp"
                    app:cardPreventCornerOverlap="true"
                    app:strokeColor="@color/brand_card_stroke"
                    app:strokeWidth="1.2dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp">

                        <FrameLayout
                            android:id="@+id/fl_icon_completed"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:background="@drawable/bg_stat_icon_emerald">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_market_cart"
                                app:tint="@color/brand_green_medium" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_label_completed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:text="@string/farmer_home_completed_orders"
                            android:textColor="@color/brand_text_body"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_completed_orders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentBottom="true"
                            android:fontFamily="sans-serif-black"
                            android:text="0"
                            android:textColor="@color/brand_text_title"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 4: Total Earnings -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_total_earnings"
                    android:layout_width="0dp"
                    android:layout_height="124dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/brand_surface_card"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="5dp"
                    app:cardMaxElevation="8dp"
                    app:cardPreventCornerOverlap="true"
                    app:strokeColor="@color/brand_card_stroke"
                    app:strokeWidth="1.2dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp">

                        <FrameLayout
                            android:id="@+id/fl_icon_earnings"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:background="@drawable/bg_stat_icon_gold">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_wallet"
                                app:tint="@color/brand_accent_gold" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_label_earnings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:text="@string/farmer_home_total_earnings"
                            android:textColor="@color/brand_text_body"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_total_earnings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentBottom="true"
                            android:fontFamily="sans-serif-black"
                            android:text="₹0"
                            android:textColor="@color/brand_green_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- Quick Actions Section -->
            <TextView
                android:id="@+id/tv_section_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                android:text="@string/farmer_home_quick_actions"
                android:textColor="@color/brand_text_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layout_quick_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- New Listing Primary Elevated Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_create_order"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_button"
                    android:elevation="5dp"
                    android:letterSpacing="0.02"
                    android:text="@string/farmer_home_new_listing"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/white" />

                <!-- My Wallet Secondary Outlined/Card Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_wallet"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:letterSpacing="0.02"
                    android:text="@string/farmer_home_my_wallet"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_green_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_wallet"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/brand_green_primary"
                    app:strokeColor="@color/brand_green_primary"
                    app:strokeWidth="1.5dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
