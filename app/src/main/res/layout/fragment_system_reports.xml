<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".fragments.SystemReportsFragment">

    <TextView
        android:id="@+id/tv_total_users"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total Users: 0" />

    <TextView
        android:id="@+id/tv_total_completed_trips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total Completed Trips: 0" />

    <TextView
        android:id="@+id/tv_total_system_revenue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total System Revenue: 0.0" />

    <com.github.mikephil.charting.charts.PieChart
        android:id="@+id/pie_chart"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
