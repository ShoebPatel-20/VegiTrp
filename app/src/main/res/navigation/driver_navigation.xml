<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/driver_navigation"
    app:startDestination="@id/navigation_driver_home">

    <fragment
        android:id="@+id/navigation_driver_home"
        android:name="com.example.vegitrp.fragments.DriverHomeFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_driver_home" />

    <fragment
        android:id="@+id/navigation_driver_dashboard"
        android:name="com.example.vegitrp.fragments.DriverDashboardFragment"
        android:label="My Trips"
        tools:layout="@layout/fragment_driver_dashboard" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.example.vegitrp.fragments.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
