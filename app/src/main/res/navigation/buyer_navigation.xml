<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/buyer_navigation"
    app:startDestination="@+id/navigation_buyer_home">

    <fragment
        android:id="@+id/navigation_buyer_home"
        android:name="com.example.vegitrp.fragments.BuyerHomeFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_buyer_home" />

    <fragment
        android:id="@+id/navigation_buyer_dashboard"
        android:name="com.example.vegitrp.fragments.BuyerDashboardFragment"
        android:label="My Orders"
        tools:layout="@layout/fragment_buyer_dashboard" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.example.vegitrp.fragments.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
