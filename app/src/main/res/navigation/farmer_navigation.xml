<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/farmer_navigation"
    app:startDestination="@id/navigation_farmer_home">

    <fragment
        android:id="@+id/navigation_farmer_home"
        android:name="com.example.vegitrp.fragments.FarmerHomeFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_farmer_home" />

    <fragment
        android:id="@+id/navigation_farmer_dashboard"
        android:name="com.example.vegitrp.fragments.FarmerDashboardFragment"
        android:label="Orders"
        tools:layout="@layout/fragment_farmer_dashboard" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.example.vegitrp.fragments.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
