<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="140dp"
    android:height="140dp"
    android:viewportWidth="140"
    android:viewportHeight="140">

    <!-- Outer Soft Glow Shadow -->
    <path
        android:pathData="M70,10 A60,60 0 1,0 70,130 A60,60 0 1,0 70,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="70"
                android:centerY="70"
                android:gradientRadius="60"
                android:type="radial">
                <item android:offset="0.0" android:color="#332E7D32" />
                <item android:offset="0.75" android:color="#1A2E7D32" />
                <item android:offset="1.0" android:color="#002E7D32" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main 3D Elevated Base Circle -->
    <path
        android:pathData="M70,18 A52,52 0 1,0 70,122 A52,52 0 1,0 70,18 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="35"
                android:startY="20"
                android:endX="105"
                android:endY="120"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.6" android:color="#F4FAF5" />
                <item android:offset="1.0" android:color="#E1EFE4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Base Circle Bevel Stroke / Subtle 3D Ring -->
    <path
        android:pathData="M70,20 A50,50 0 1,0 70,120 A50,50 0 1,0 70,20 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#CCE3D2" />

    <!-- Inner Emerald Gradient Shield / Plate -->
    <path
        android:pathData="M70,28 A42,42 0 1,0 70,112 A42,42 0 1,0 70,28 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="70"
                android:startY="28"
                android:endX="70"
                android:endY="112"
                android:type="linear">
                <item android:offset="0.0" android:color="#E8F8ED" />
                <item android:offset="1.0" android:color="#C8EAD1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Road / Transport Track Arc (Bottom Depth) -->
    <path
        android:pathData="M38,92 C48,84 92,84 102,92 C92,97 48,97 38,92 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="70"
                android:startY="84"
                android:endX="70"
                android:endY="97"
                android:type="linear">
                <item android:offset="0.0" android:color="#81C784" />
                <item android:offset="1.0" android:color="#388E3C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Transport Dash Lines -->
    <path
        android:pathData="M52,90 L62,88 M78,88 L88,90"
        android:strokeWidth="2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Big Agriculture Leaf (Back layer shadow) -->
    <path
        android:pathData="M72,36 C52,40 40,58 43,78 C44,85 49,90 56,91 C76,91 97,72 96,48 C96,40 88,34 72,36 Z"
        android:fillColor="#1F1B5E20" />

    <!-- Big Agriculture Leaf (Main 3D Body) -->
    <path
        android:pathData="M70,34 C50,38 38,56 41,76 C42,83 47,88 54,89 C74,89 95,70 94,46 C94,38 86,32 70,34 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="35"
                android:endX="95"
                android:endY="90"
                android:type="linear">
                <item android:offset="0.0" android:color="#4CAF50" />
                <item android:offset="0.5" android:color="#2E7D32" />
                <item android:offset="1.0" android:color="#1B5E20" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Leaf Center Rib / Vein (Golden Sunlight Accent) -->
    <path
        android:pathData="M46,80 C54,72 68,58 84,42"
        android:strokeWidth="2.5"
        android:strokeColor="#A5D6A7"
        android:strokeLineCap="round" />
    <path
        android:pathData="M58,68 C64,68 70,72 73,75"
        android:strokeWidth="1.8"
        android:strokeColor="#C8E6C9"
        android:strokeLineCap="round" />
    <path
        android:pathData="M68,56 C74,56 79,59 82,62"
        android:strokeWidth="1.8"
        android:strokeColor="#C8E6C9"
        android:strokeLineCap="round" />

    <!-- Small Secondary Sprout Leaf (Right side accent) -->
    <path
        android:pathData="M72,48 C85,46 98,54 100,66 C100,72 96,77 90,78 C80,78 70,68 72,48 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="72"
                android:startY="48"
                android:endX="100"
                android:endY="78"
                android:type="linear">
                <item android:offset="0.0" android:color="#81C784" />
                <item android:offset="1.0" android:color="#388E3C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Transport Delivery Truck 3D Badge Overlay -->
    <!-- Truck Shadow -->
    <path
        android:pathData="M58,74 L84,74 C86,74 88,76 88,78 L88,86 C88,87 87,88 86,88 L56,88 C55,88 54,87 54,86 L54,78 C54,76 56,74 58,74 Z"
        android:fillColor="#33000000" />

    <!-- Truck Cargo Body -->
    <path
        android:pathData="M56,71 L76,71 C77,71 78,72 78,73 L78,85 L54,85 L54,73 C54,72 55,71 56,71 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="66"
                android:startY="71"
                android:endX="66"
                android:endY="85"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="1.0" android:color="#E0E0E0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Truck Cabin (Amber / Gold Accent) -->
    <path
        android:pathData="M78,74 L84,74 C85.5,74 87,75.5 87.5,77 L89,80 L89,85 L78,85 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="83"
                android:startY="74"
                android:endX="83"
                android:endY="85"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFB74D" />
                <item android:offset="1.0" android:color="#F57C00" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Truck Window -->
    <path
        android:pathData="M79,75 L84,75 L86,79 L79,79 Z"
        android:fillColor="#37474F" />

    <!-- Truck Wheels -->
    <path
        android:pathData="M60,86 A3.5,3.5 0 1,0 60,79 A3.5,3.5 0 1,0 60,86 Z"
        android:fillColor="#263238" />
    <path
        android:pathData="M60,83.5 A1.2,1.2 0 1,0 60,81 A1.2,1.2 0 1,0 60,83.5 Z"
        android:fillColor="#FFFFFF" />

    <path
        android:pathData="M83,86 A3.5,3.5 0 1,0 83,79 A3.5,3.5 0 1,0 83,86 Z"
        android:fillColor="#263238" />
    <path
        android:pathData="M83,83.5 A1.2,1.2 0 1,0 83,81 A1.2,1.2 0 1,0 83,83.5 Z"
        android:fillColor="#FFFFFF" />

    <!-- Top Gloss Arc (3D Specular Highlight) -->
    <path
        android:pathData="M34,50 C42,32 60,22 80,22 C90,22 98,25 106,30 C96,25 80,24 66,28 C48,34 38,44 34,50 Z"
        android:fillColor="#66FFFFFF" />

</vector>
